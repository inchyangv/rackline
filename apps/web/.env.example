# Read-only JSON-RPC (never put secrets in frontend env)
VITE_RPC_URL=https://rpc.cc3-testnet.creditcoin.network
VITE_CHAIN_ID=102031

# Contract addresses (fill with deployed addresses)
VITE_HASH_CREDIT_MANAGER=0x593e140982cDC040d69B7E7623A045C6d6Ca2055
VITE_BTC_SPV_VERIFIER=0x16DEd6a617a911471cd4549C24Ed8C281f096fd2

# Vault & Stablecoin addresses
VITE_VAULT_ADDRESS=0x4d74126369BacB67085a1E70d535cA15515d1AFa
VITE_STABLECOIN_ADDRESS=0xb9D6E174C8e0267Fb0cC3F2AC34130D680151B6A

# Backend API base URL for this deployment (Railway service `rackline-api`), e.g. https://api.<rackline-domain>
# Empty = API-backed steps are disabled with a visible reason. Never put secrets in frontend env.
VITE_API_URL=

# API profile of the backend this build talks to. Default 'production': the UI never requests
# demo registration/credit. Set 'testnet_demo' only for a TEST_ONLY deployment whose API runs
# with API_PROFILE=testnet_demo.
# VITE_API_PROFILE=production
