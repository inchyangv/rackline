FROM python:3.11-slim

# Root-level Dockerfile variant for the SPV worker (Railway background service).

WORKDIR /app

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

RUN pip install --no-cache-dir --upgrade pip

# The prover depends on the shared local package `hashcredit-gpu` (offchain/gpu, GPU-015); install it first.
# Build with the repository root as the build context.
COPY offchain/gpu/ /opt/hashcredit_gpu/
RUN pip install --no-cache-dir /opt/hashcredit_gpu

# Copy only the prover package from the monorepo.
COPY offchain/prover/ ./

RUN pip install --no-cache-dir -e .

# Keep worker startup resilient even if the platform start command is misconfigured.
ENTRYPOINT ["sh", "./start-worker.sh"]
