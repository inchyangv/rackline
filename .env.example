# Rackline GPU application
# Copy to .env for local services. Never commit real credentials.

# PostgreSQL
HASHCREDIT_GPU_DATABASE_URL=postgresql+psycopg2://postgres:postgres@127.0.0.1:5432/rackline

# Deployment identity
GPU_EXECUTION_PROFILE=NATIVE_TESTNET
GPU_CHAIN_ID=102031
GPU_DEPLOYMENT_ID=01K54G0000QN0QHY2GCA10HGXN
GPU_MANIFEST_HASH=sha256:27f290dd50b0f4a773269fb1cdc64fb5ec648c0acf64cfc2fbe0cc4a6c5976b2
GPU_DEPLOYMENT_MANIFEST=config/gpu/deployments/cc3-testnet.json
GPU_ATTESTCOIN_MANIFEST=config/attestcoin/cc3-testnet.sepolia.release.json
GPU_ABI_DIRECTORY=offchain/gpu/hashcredit_gpu/projections/abi

# API
GPU_APP_DOMAIN=localhost
GPU_SESSION_SECRET=
GPU_CORS_ORIGINS=["http://127.0.0.1:5173","http://localhost:5173"]
GPU_RPC_URL=https://rpc.cc3-testnet.creditcoin.network
PORT=8000

# Container worker selection: api | indexer | proof
GPU_SERVICE=api
ATTESTCOIN_CLI=offchain/attestcoin/dist/src/cli.js
GPU_ARTIFACT_DIR=.artifacts/proofs
# GPU_SUBMISSION_PLANS=/secure/reviewed-submission-plans.json
# GPU_KEEPER_PRIVATE_KEY=

# The legacy Bitcoin-SPV prototype uses separate variables documented in its
# package modules. It is not part of the Rackline v2 deployment.
