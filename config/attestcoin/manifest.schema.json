{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "rackline/attestcoin/manifest/v1",
  "title": "Attestcoin environment manifest (v1)",
  "description": "Binds a verifier build and proof worker to one official Attestcoin deployment, one source chainKey/encoding, and pinned SDK/ABI/decoder artifacts. Semantic rules beyond this schema (official precompile addresses in native profiles, profile↔chainId, PROBED requires PROBE, no local URLs in native profiles, stale-hash rejection, secret detection) are enforced by offchain/attestcoin/src/manifest.ts validateManifest().",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "manifestVersion", "manifestId", "executionProfile", "requiredVerification", "verificationMethod",
    "environmentStatus", "mock", "destination", "source", "proofService", "sdk", "contracts",
    "deploymentBlock", "secretRefs", "notes", "manifestHash"
  ],
  "properties": {
    "manifestVersion": { "const": 1 },
    "manifestId": { "type": "string", "pattern": "^[a-z0-9][a-z0-9.-]*$" },
    "executionProfile": { "enum": ["LOCAL_MOCK", "NATIVE_TESTNET", "PRODUCTION"] },
    "requiredVerification": { "const": "ATTESTCOIN_NATIVE", "description": "R2-D02: official native verification is the only accepted method for source facts." },
    "verificationMethod": { "enum": ["ATTESTCOIN_NATIVE", "LOCAL_MOCK"], "description": "LOCAL_MOCK only with executionProfile=LOCAL_MOCK and mock=true." },
    "environmentStatus": { "enum": ["UNCONFIRMED", "PROBED", "UNSUPPORTED"], "description": "What the read-only probe confirmed. Never implies nativeStatus=VERIFIED for any proof." },
    "mock": { "type": "boolean" },
    "destination": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "chainId", "rpcUrls", "blockProver", "chainInfo", "decoder"],
      "properties": {
        "name": { "type": "string" },
        "chainId": { "type": "integer", "minimum": 1, "description": "Creditcoin EVM chain id: 102030 mainnet, 102031 testnet, 102032 devnet (NativeQueryVerifierLib.isCreditcoinChainId)." },
        "rpcUrls": { "type": "array", "minItems": 1, "items": { "type": "string", "format": "uri" }, "description": "Read-only allowlist; https without credentials/query in native profiles." },
        "blockProver": { "type": "object", "required": ["address"], "properties": { "address": { "$ref": "#/$defs/address" } }, "additionalProperties": false },
        "chainInfo": { "type": "object", "required": ["address"], "properties": { "address": { "$ref": "#/$defs/address" } }, "additionalProperties": false },
        "decoder": {
          "type": "object",
          "additionalProperties": false,
          "required": ["address", "codeKeccak256", "sourcePackage", "sourceFile", "sourceSha256"],
          "properties": {
            "address": { "oneOf": [{ "$ref": "#/$defs/address" }, { "type": "null" }] },
            "codeKeccak256": { "oneOf": [{ "$ref": "#/$defs/bytes32" }, { "type": "null" }], "description": "keccak256 of deployed runtime code observed by the probe." },
            "sourcePackage": { "type": "string" },
            "sourceFile": { "type": "string" },
            "sourceSha256": { "$ref": "#/$defs/sha256" }
          }
        }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "chainId", "chainKey", "encoding", "genesisBlock", "supportConfirmedAt", "supportConfirmedBy", "rpcUrls", "emitters", "tokens"],
      "properties": {
        "name": { "type": "string" },
        "chainId": { "type": "integer", "minimum": 1, "description": "EVM chain id of the source chain (e.g. 11155111 Sepolia)." },
        "chainKey": { "type": "integer", "minimum": 1, "description": "Creditcoin-internal chain key from ChainInfo.get_supported_chains(); NOT the EVM chain id." },
        "encoding": { "const": 1, "description": "SDK EncodingVersion.V1; the only encoding the pinned SDK/decoder implement." },
        "genesisBlock": { "type": "integer", "minimum": 0 },
        "supportConfirmedAt": { "oneOf": [{ "type": "string", "format": "date-time" }, { "type": "null" }] },
        "supportConfirmedBy": { "oneOf": [{ "enum": ["DOCS", "PROBE"] }, { "type": "null" }] },
        "rpcUrls": { "type": "array", "items": { "type": "string", "format": "uri" } },
        "emitters": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["address", "kind", "deploymentBlock", "note"],
            "properties": {
              "address": { "$ref": "#/$defs/address" },
              "kind": { "type": "string" },
              "deploymentBlock": { "oneOf": [{ "type": "integer", "minimum": 0 }, { "type": "null" }] },
              "note": { "type": "string" }
            }
          },
          "description": "Registered source emitters (GPU-077/080). Empty until a TEST_ONLY or verified partner contract is registered."
        },
        "tokens": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["address", "symbol", "decimals"],
            "properties": {
              "address": { "$ref": "#/$defs/address" },
              "symbol": { "type": "string" },
              "decimals": { "type": "integer", "minimum": 0, "maximum": 36 }
            }
          }
        }
      }
    },
    "proofService": {
      "type": "object",
      "additionalProperties": false,
      "required": ["baseUrl", "alternateBaseUrls", "paths", "responseSchema"],
      "properties": {
        "baseUrl": { "type": "string", "format": "uri" },
        "alternateBaseUrls": { "type": "array", "items": { "type": "string", "format": "uri" }, "description": "Other documented hostnames; probed separately, never assumed to be aliases." },
        "paths": {
          "type": "object",
          "additionalProperties": false,
          "required": ["proofByTx", "proofBatchByTx", "attestedHeight"],
          "properties": {
            "proofByTx": { "const": "/api/v1/proof-by-tx" },
            "proofBatchByTx": { "const": "/api/v1/proof-batch-by-tx" },
            "attestedHeight": { "const": "/api/v1/attested-height" }
          }
        },
        "responseSchema": { "type": "string" }
      }
    },
    "sdk": {
      "type": "object",
      "additionalProperties": false,
      "required": ["package", "version", "integrity", "abiSha256"],
      "properties": {
        "package": { "const": "@gluwa/usc-sdk" },
        "version": { "type": "string" },
        "integrity": { "type": "string", "pattern": "^sha512-" },
        "abiSha256": { "type": "object", "additionalProperties": { "$ref": "#/$defs/sha256" } }
      }
    },
    "contracts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["package", "version", "files"],
      "properties": {
        "package": { "const": "@gluwa/asc-contracts" },
        "version": { "type": "string" },
        "files": { "type": "object", "additionalProperties": { "$ref": "#/$defs/sha256" } }
      }
    },
    "deploymentBlock": { "oneOf": [{ "type": "integer", "minimum": 0 }, { "type": "null" }] },
    "secretRefs": { "type": "object", "additionalProperties": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]*$" }, "description": "Environment variable NAMES only. Values never live in a manifest." },
    "notes": { "type": "array", "items": { "type": "string" } },
    "manifestHash": { "oneOf": [{ "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }, { "type": "null" }], "description": "sha256 of canonical JSON (sorted keys) of the manifest without this field." }
  },
  "$defs": {
    "address": { "type": "string", "pattern": "^0x[0-9a-fA-F]{40}$" },
    "bytes32": { "type": "string", "pattern": "^0x[0-9a-f]{64}$" },
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
  }
}
